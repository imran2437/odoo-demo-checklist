<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="checklist_owner_company_rule" model="ir.rule">
        <field name="name">Checklists: own records in allowed companies</field>
        <field name="model_id" ref="model_imran_daily_checklist"/>
        <field name="domain_force">[('user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="checklist_item_owner_company_rule" model="ir.rule">
        <field name="name">Checklist tasks: own records in allowed companies</field>
        <field name="model_id" ref="model_imran_daily_checklist_item"/>
        <field name="domain_force">[('user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
